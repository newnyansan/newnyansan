# Copy to .env. Generate the key once and NEVER change it afterwards:
# provider keys in the database are encrypted with it.
#   openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Image tag to run. The upgrade script sets this for you.
FREELLMAPI_VERSION=v0.16.26

# PORT=3001
# HOST_BIND=127.0.0.1
